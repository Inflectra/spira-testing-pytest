# SpiraTest Configuration
# Copy this file to .env.spira and fill in your credentials

# Required settings
SPIRA_URL=http://localhost/spira
SPIRA_USERNAME=administrator
SPIRA_TOKEN={B9050F75-C5E6-4244-8712-FBF20061A976}
SPIRA_PROJECT_ID=1

# Optional settings
SPIRA_RELEASE_ID=5
SPIRA_TEST_SET_ID=1

# Optional: Enable verbose logging (true/false, yes/no, 1/0, on/off)
SPIRA_VERBOSE=false

# Optional: Enable/disable Spira integration (true/false, yes/no, 1/0, on/off)
SPIRA_ENABLED=true

# Optional: Enable batch mode - post all results at once (true/false, yes/no, 1/0, on/off)
# Improves performance for large test suites (100+ tests)
SPIRA_BATCH_MODE=false
